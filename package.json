{
  "name": "t2-doc-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local web viewer for office/ebook formats with bookmarking and annotation features: docm, dotx, dotm, wps, xml, pages, xps, mobi, epub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "client": "react-scripts start",
    "build": "react-scripts build",
    "prebuild": "node scripts/pdf-assets.cjs",
    "preclient": "node scripts/pdf-assets.cjs",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:organizer": "node scripts/organizer-smoke.mjs",
    "test:storage": "node scripts/storage-smoke.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "adm-zip": "^0.5.12",
    "express": "^4.19.2",
    "fflate": "0.8.2",
    "gsap": "^3.13.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.77.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-pdf": "^11.1.0",
    "react-scripts": "^5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
